# Key proxy (docs/scenarios-design.md, section 4). nginx fills ${ANTHROPIC_API_KEY}
# from the run's key file at startup; the agent's container never holds the key.
# Only the API paths Claude Code needs are forwarded. Denied requests are logged
# with method and path only; nothing else is logged.
log_format denied '$request_method $uri $status';

server {
  listen 8080;
  access_log off;

  location = /v1/messages {
    proxy_pass https://api.anthropic.com;
    proxy_ssl_server_name on;
    proxy_set_header Host api.anthropic.com;
    proxy_set_header x-api-key "${ANTHROPIC_API_KEY}";
    proxy_set_header Authorization "";
    proxy_buffering off;
    proxy_read_timeout 600s;
    proxy_http_version 1.1;
  }

  location = /v1/messages/count_tokens {
    proxy_pass https://api.anthropic.com;
    proxy_ssl_server_name on;
    proxy_set_header Host api.anthropic.com;
    proxy_set_header x-api-key "${ANTHROPIC_API_KEY}";
    proxy_set_header Authorization "";
    proxy_http_version 1.1;
  }

  location / {
    access_log /dev/stdout denied;
    return 403;
  }
}
